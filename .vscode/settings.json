{
  // Configuração do Biome como formatador padrão
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "quickfix.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },

  // Desabilitar formatadores concorrentes para arquivos que o Biome suporta
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "quickfix.biome": "explicit",
      "source.organizeImports.biome": "explicit",
      // Desabilitar o organizador de imports do TypeScript
      "source.organizeImports": "never"
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "quickfix.biome": "explicit",
      "source.organizeImports.biome": "explicit",
      "source.organizeImports": "never"
    }
  },
  "[vue]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "quickfix.biome": "explicit",
      "source.organizeImports.biome": "explicit",
      "source.organizeImports": "never"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },

  // Configurações específicas do TypeScript para evitar conflitos
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnFileMove": "always",

  // Configurações do Biome
  "biome.enabled": true,
  "biome.lsp.bin": "biome",

  // Desabilitar outros linters/formatadores que podem conflitar
  "eslint.enable": false,
  "prettier.enable": false
}
